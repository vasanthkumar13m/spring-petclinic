pipeline {

    agent any

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Docker Image Tag'
        )
    }

    environment {
        EC2_HOST = "13.234.111.85"
        EC2_USER = "ubuntu"
        IMAGE_NAME = "somisettyvasanth/petclinic"
        CONTAINER_NAME = "petclinic"
        DOCKER_CREDS = credentials('dockerhub-creds')
    }

    stages {

        stage('Approval') {
            steps {
                input(
                    message: "Deploy Docker Image ${params.IMAGE_TAG} to EC2?",
                    ok: "Deploy"
                )
            }
        }

        stage('Deploy to EC2') {

            steps {

                sshagent(credentials: ['ec2-ssh-key']) {

                    sh """
                    ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} '

                    set -e
                     echo ${DOCKER_CREDS_PSW} | docker login \
                -u ${DOCKER_CREDS_USR} \
                --password-stdin

                    echo "===== Pull Docker Image ====="

                    docker pull ${IMAGE_NAME}:${params.IMAGE_TAG}

                    echo "===== Stop Existing Container ====="

                    docker stop ${CONTAINER_NAME} || true

                    echo "===== Remove Existing Container ====="

                    docker rm ${CONTAINER_NAME} || true

                    echo "===== Run Container ====="

                    docker run -d \
                      --name ${CONTAINER_NAME} \
                      -p 8080:8080 \
                      ${IMAGE_NAME}:${params.IMAGE_TAG}

                    echo "Waiting for application..."
                    sleep 20

                    echo "===== Running Containers ====="
                    docker ps || true

                    echo "===== Health Check ====="
                    curl -ikL http://localhost:8080 || true

                    '

                    """
                }
            }
        }
    }

    post {

        success {
            echo "Application Successfully Deployed"
        }

        failure {
            echo "Deployment Failed"
        }
    }
}
