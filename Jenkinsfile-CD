pipeline {

    agent any

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Docker Image Tag'
        )
    }

    stages {

        stage('Approval') {

            steps {

                input(
                    message: "Deploy Docker Image ${params.IMAGE_TAG} to EC2?",
                    ok: "Deploy"
                )

            }

        }

        stage('Deploy To EC2') {

            steps {

                sshPublisher(

                    publishers: [

                        sshPublisherDesc(

                            configName: 'ec2-instance',

                            transfers: [

                                sshTransfer(

                                    execCommand: """

                                    docker pull somisettyvasanth/petclinic:${params.IMAGE_TAG}

                                    docker stop petclinic || true

                                    docker rm petclinic || true

                                    docker run -d \
                                    --name petclinic \
                                    --restart unless-stopped \
                                    -p 8080:8080 \
                                    somisettyvasanth/petclinic:${params.IMAGE_TAG}

                                    sleep 20

                                    docker ps

                                    docker logs --tail 30 petclinic

                                    curl -f http://localhost:8080

                                    """

                                )

                            ]

                        )

                    ]

                )

            }

        }

    }

    post {

        success {
            echo 'Application Successfully Deployed'
        }

        failure {
            echo 'Deployment Failed'
        }

    }

}
