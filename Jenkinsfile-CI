pipeline {

    agent any

    tools {
        maven 'maven'
    }

    environment {

        DOCKER_IMAGE = "somisettyvasanth/spring"

        DOCKER_CREDS = credentials('dockerhub-creds')

        ARTIFACTORY_USER = credentials('jfrog-creds')
        SCANNER_HOME  = tool 'sonar'
        EC2_USER = "ubuntu"
        EC2_HOST = "3.109.208.200"

    }

    stages {

        stage('Checkout') {

            steps {

                git branch: 'feature/practice-vasanth',
                credentialsId: 'github',
                url: 'https://github.com/vasanthkumar13m/spring-petclinic.git'

            }

        }

        stage('Build') {

            steps {

                sh 'mvn clean package'

            }

        }

        stage('SonarQube Analysis') {
    steps {
        withSonarQubeEnv('SonarQube') {
            withCredentials([
                string(
                    credentialsId: 'sonar-token',
                    variable: 'SONAR_TOKEN'
                )
            ]) {
                sh """
                    ${SCANNER_HOME}/bin/sonar-scanner \
                    -Dsonar.token=$SONAR_TOKEN
                """
            }
        }
    }
}

        stage('Upload Artifact To JFrog') {

            steps {

                sh """

                curl -u ${ARTIFACTORY_USER_USR}:${ARTIFACTORY_USER_PSW} \
                -T target/*.jar \
                http://localhost:8082/artifactory/libs-release-local/spring/

                """

            }

        }

        stage('Download Artifact From JFrog') {

            steps {

                sh """

                rm -f petclinic.jar

                curl -u ${ARTIFACTORY_USER_USR}:${ARTIFACTORY_USER_PSW} \
                -o petclinic.jar \
                http://localhost:8082/artifactory/libs-release-local/spring/spring-petclinic-4.0.0-SNAPSHOT.jar

                """

            }

        }

        stage('Build Docker Image') {

            steps {

                sh """

                docker build \
                -t ${DOCKER_IMAGE}:${BUILD_NUMBER} .

                """

            }

        }

        stage('Docker Login') {

            steps {

                sh """

                echo ${DOCKER_CREDS_PSW} | docker login \
                -u ${DOCKER_CREDS_USR} \
                --password-stdin

                """

            }

        }

        stage('Push Docker Image') {

            steps {

                sh """

                docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}

                """

            }

        }

        stage('Update GitOps Repo') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_TOKEN'
                        )
                     ]) {
                         sh '''
                           git clone https://${GIT_USER}:${GIT_TOKEN}@github.com/vasanthkumar13m/Kubernetes-Deploy-ArgoCD.git gitops
                           cd gitops
                           sed -i "s#image:.*#image: ${DOCKER_IMAGE}:${BUILD_NUMBER}#" deployment.yml
                           git config user.name "vasanthkumar13m"
                           git config user.email "somisettyvasanthkumar@gmail.com"
                           git add deployment.yml
                           git commit -m "Update image to ${BUILD_NUMBER  }" || true
                           git push origin master
                        '''
                 }
              }
           }
        }

    post {

        success {

            echo "CI Pipeline Completed Successfully"

        }

        always {

            cleanWs()

        }
     }
}
